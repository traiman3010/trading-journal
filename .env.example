# ─────────────────────────────────────────────────────
# .env.example — template สำหรับ developer ใหม่
# copy ไฟล์นี้เป็น .env แล้วเติมค่าจริง
# วิธี: cp .env.example .env
# ─────────────────────────────────────────────────────

# Postgres connection string (Neon, local, หรือ provider อื่น)
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# Auth.js secret — ใช้ sign JWT + encrypt session cookie
# generate ด้วย: openssl rand -base64 33
AUTH_SECRET="<generate-your-own-with-openssl-rand-base64-33>"
